<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RegionLivePreview.Views.SelectionOverlayWindow"
        Title="选择预览区域"
        SystemDecorations="None"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        KeyDown="OnKeyDown"
        SizeChanged="OnSizeChanged">

    <Grid x:Name="Root"
          Background="Transparent"
          Focusable="True"
          Cursor="Cross"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          PointerCaptureLost="OnPointerCaptureLost">

        <Canvas x:Name="Layer" IsHitTestVisible="False">
            <Rectangle x:Name="DimTop" Fill="#66000000" />
            <Rectangle x:Name="DimBottom" Fill="#66000000" />
            <Rectangle x:Name="DimLeft" Fill="#66000000" />
            <Rectangle x:Name="DimRight" Fill="#66000000" />

            <Rectangle x:Name="SelectionBorder"
                       Stroke="#3D8BFF"
                       StrokeThickness="1.5"
                       IsVisible="False" />

            <Border x:Name="SizeBadge"
                    Background="#E60B0E14"
                    BorderBrush="#553D8BFF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,3"
                    IsVisible="False">
                <TextBlock x:Name="SizeText"
                           Foreground="#F2FFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <Border x:Name="HintBadge"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,40,0,0"
                Background="#E60B0E14"
                BorderBrush="#223D8BFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                IsHitTestVisible="False">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="7" Height="7" Fill="#3D8BFF" VerticalAlignment="Center" />
                    <TextBlock Text="拖动鼠标选择要实时预览的区域"
                               Foreground="#F0FFFFFF"
                               FontSize="13" />
                    <TextBlock Text="·"
                               Foreground="#668899B0"
                               FontSize="13" />
                    <TextBlock Text="Esc 取消"
                               Foreground="#A0FFFFFF"
                               FontSize="13" />
                </StackPanel>
                <TextBlock Text="快捷键、自动选区等可在托盘图标 →「设置…」中修改"
                           Foreground="#8A93A6"
                           FontSize="11"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
