<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RegionLivePreview.Views.MessageDialog"
        Title="RegionLivePreview"
        Width="470"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#0F1218">

    <StackPanel Margin="24" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="9" Height="9" Fill="#3D8BFF" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#F2FFFFFF"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="MessageText"
                   FontSize="13"
                   LineHeight="21"
                   Foreground="#CCFFFFFF"
                   TextWrapping="Wrap" />

        <Button Content="知道了"
                Classes="accent"
                MinWidth="92"
                HorizontalAlignment="Right"
                Click="OnOkClick" />
    </StackPanel>
</Window>
